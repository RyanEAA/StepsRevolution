HOST=127.0.0.1
PORT=3001

# Replace this with the final public HTTPS origin.
# Do not include a trailing slash.
CLIENT_ORIGINS=https://dance.example.com

# Private temporary storage used by the multiplayer asset relay.
RELAY_TEMP_DIR=/var/lib/dance-vision/relay

# Total temporary asset quota for one room.
RELAY_ROOM_QUOTA_MB=200

# Temporary relay asset lifetime.
RELAY_ASSET_TTL_MINUTES=30